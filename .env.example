# LANKA v2 ortam değişkenleri (tümü opsiyonel — varsayılanlar gerçek Binance uç noktalarıdır)

# Canlı veri: Binance birleşik stream (depth20@100ms + kline + ticker)
VITE_BINANCE_WS=wss://stream.binance.com:9443
# Birincil WS host'una erişilemezse sırayla denenecek gerçek yedek host'lar (virgülle)
VITE_BINANCE_WS_FALLBACKS=wss://stream.binance.com:443,wss://data-stream.binance.vision

# Geçmiş mum (REST /api/v3/klines)
VITE_BINANCE_REST=https://api.binance.com
VITE_BINANCE_REST_FALLBACKS=https://data-api.binance.vision

# Not: Uygulama yalnızca gerçek borsa verisiyle çalışır; simülasyon/mock veri
# katmanı yoktur. Kendi proxy'nizi kullanmak isterseniz yukarıdaki host'ları
# kendi adresinizle değiştirin (ör. VITE_BINANCE_REST=/binance — aynı origin).
