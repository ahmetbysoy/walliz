# LANKA v2 ortam değişkenleri (tümü opsiyonel)

# '1' ise demo feed ZORLA kullanılır (offline geliştirme / test / sandbox)
VITE_DEMO_MODE=

# Binance birleşik stream (canlı veri)
VITE_BINANCE_WS=wss://stream.binance.com:9443

# Binance REST (kline geçmişi için)
VITE_BINANCE_REST=https://api.binance.com

# Demo feed deterministik seed'i (boşsa symbol+timeframe hash kullanılır)
VITE_DEMO_SEED=
